# ---------------------------------------------------------------------------
# Centre Imam Malik - Environment configuration
# Copy to .env and fill in. install.bat generates .env automatically.
# NEVER commit .env - it contains secrets.
# ---------------------------------------------------------------------------

# Local SQLite database (default: offline, Windows friendly)
DATABASE_URL="file:./prisma/data/centre.db"

# Cryptographically random, generated by install.bat. 64+ hex characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=""

# Public base URL of the app (used for links in emails/notifications)
APP_URL="http://localhost:3000"

# Bind address. 127.0.0.1 = this computer only.
# Use 0.0.0.0 to make the application reachable from other machines on the
# local network (phones, tablets); then set APP_URL to this machine's LAN IP.
HOSTNAME="127.0.0.1"
PORT="3000"

# UI default language: fr | ar
DEFAULT_LOCALE="fr"

# Node environment: production | development
NODE_ENV="production"

# ---------------------------------------------------------------------------
# Centre identity and initial administrator.
# Written by the installer from the answers given during setup; listed here so
# the fields are discoverable. Editing them later does NOT rename the centre
# already in the database - change it in the application.
# ---------------------------------------------------------------------------
# SEED_CENTER_CODE="CIM"
# SEED_CENTER_NAME_FR=""
# SEED_CENTER_NAME_AR=""
# SEED_CENTER_ADDRESS=""
# SEED_CENTER_PHONE=""
# SEED_CENTER_EMAIL=""
# SEED_ADMIN_EMAIL=""
# SEED_ADMIN_PASSWORD=""
# SEED_ADMIN_FIRST_NAME=""
# SEED_ADMIN_LAST_NAME="
