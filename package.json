{
  "name": "centre-imam-malik",
  "version": "1.0.0",
  "private": true,
  "description": "Centre Imam Malik de Soutien, Formation et Langues - Management System",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "tsx e2e/prepare.ts && playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "dev:admin": "tsx scripts/create-dev-admin.ts",
    "setup": "node scripts/setup.mjs",
    "postinstall": "prisma generate",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "verify:pdf": "tsx scripts/verify-arabic-pdf.tsx",
    "backup": "node scripts/backup.mjs"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "jose": "^6.1.0",
    "next": "^16.3.7",
    "pdfmake": "^0.3.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@prisma/client": "^7.10.0",
    "@react-pdf/renderer": "^4.3.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "postcss": "^8.5.28",
    "prisma": "^7.10.0",
    "recharts": "^3.3.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.1",
    "mysql2": "3.24.5"
  }
}
